@inproceedings{taskiran_attacks_2006,
  title = {Attacks on Lexical Natural Language Steganography Systems},
  booktitle = {Security, {{Steganography}}, and {{Watermarking}} of {{Multimedia Contents VIII}}},
  author = {Taskiran, Cuneyt M. and Topkara, Umut and Topkara, Mercan and Delp, Edward J.},
  year = {2006},
  month = feb,
  volume = {6072},
  pages = {97--105},
  publisher = {{SPIE}},
  doi = {10.1117/12.649551},
  url = {https://www.spiedigitallibrary.org/conference-proceedings-of-spie/6072/607209/Attacks-on-lexical-natural-language-steganography-systems/10.1117/12.649551.full},
  urldate = {2023-01-12},
  abstract = {Text data forms the largest bulk of digital data that people encounter and exchange daily. For this reason the potential usage of text data as a covert channel for secret communication is an imminent concern. Even though information hiding into natural language text has started to attract great interest, there has been no study on attacks against these applications. In this paper we examine the robustness of lexical steganography systems.In this paper we used a universal steganalysis method based on language models and support vector machines to differentiate sentences modified by a lexical steganography algorithm from unmodified sentences. The experimental accuracy of our method on classification of steganographically modified sentences was 84.9\%. On classification of isolated sentences we obtained a high recall rate whereas the precision was low.}
}

